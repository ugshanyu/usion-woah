{
  "name": "usion-woah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "postinstall": "npm run prepare:assets",
    "build": "npm run prepare:assets && tsc -b && vite build",
    "start": "node server.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  }
}
